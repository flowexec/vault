{
  "id": "1password",
  "type": "external",
  "external": {
    "get": {
      "cmd": "op read --no-newline '{{ref}}'"
    },
    "metadata": {
      "cmd": "op account list"
    },
    "reference_pattern": "^op://[^/]+/[^/]+/[^/]+(/[^/]+)?$",
    "not_found_pattern": "isn't an item",
    "timeout": "120s"
  }
}
