{
  "id": "aws-ssm",
  "type": "external",
  "external": {
    "get": {
      "cmd": "aws ssm get-parameter --name '{{ref}}' --with-decryption --query Parameter.Value --output text"
    },
    "metadata": {
      "cmd": "aws sts get-caller-identity --output json",
      "output": "AWS account {{ fromJSON(output)[\"Account\"] }} as {{ fromJSON(output)[\"Arn\"] }}"
    },
    "reference_pattern": "^/[A-Za-z0-9._/-]+$",
    "not_found_pattern": "ParameterNotFound",
    "environment": {
      "AWS_PAGER": ""
    },
    "timeout": "60s"
  }
}
