{
  "id": "bitwarden",
  "type": "external",
  "external": {
    "get": {
      "cmd": "bw get item '{{ref}}' | jq -r '.login.password'"
    },
    "metadata": {
      "cmd": "bw status"
    },
    "reference_pattern": "^[0-9a-fA-F][0-9a-fA-F-]{7,63}$",
    "not_found_pattern": "Not found",
    "timeout": "120s"
  }
}
